{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algonext.local/schemas/tracking-annotation-v1.schema.json",
  "title": "AlgoNext tracking annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "video_id", "frames"],
  "properties": {
    "schema_version": {"const": "tracking-annotation-v1"},
    "video_id": {"type": "string", "minLength": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame_index", "objects"],
        "properties": {
          "frame_index": {"type": "integer", "minimum": 0},
          "time_sec": {"type": "number", "minimum": 0},
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identity", "bbox"],
              "properties": {
                "identity": {"type": "string", "minLength": 1},
                "ignore": {"type": "boolean", "default": false},
                "bbox": {"$ref": "#/$defs/bbox"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  }
}
